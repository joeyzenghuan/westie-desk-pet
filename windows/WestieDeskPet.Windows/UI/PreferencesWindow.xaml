<Window x:Class="WestieDeskPet.Windows.UI.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⚙️ 桌面宠物陪伴偏好设置"
        Width="470" Height="740"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="#F6F7F9"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,4,0">

                <!-- Section 0: Pet Species & Size -->
                <GroupBox Header="🐾 宠物角色与外观大小" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <UniformGrid Columns="2" Margin="0,0,0,10">
                            <RadioButton x:Name="WestieRadio" Content="🐶 西高地小狗" Margin="0,0,12,6" Checked="PetSpeciesRadio_Changed" />
                            <RadioButton x:Name="CatRadio" Content="🐱 金渐层小猫" Margin="0,0,0,6" Checked="PetSpeciesRadio_Changed" />
                            <RadioButton x:Name="LabradorRadio" Content="🐕 拉布拉多小狗" Margin="0,0,12,6" Checked="PetSpeciesRadio_Changed" />
                            <RadioButton x:Name="ChinchillaRadio" Content="🐈 金吉拉小猫" Margin="0,0,0,6" Checked="PetSpeciesRadio_Changed" />
                            <RadioButton x:Name="SilverChinchillaRadio" Content="❄️ 银白金吉拉" Checked="PetSpeciesRadio_Changed" />
                        </UniformGrid>

                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="宠物尺寸" DockPanel.Dock="Left" />
                            <TextBlock x:Name="ScaleValueText" Text="150%" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#555" />
                        </DockPanel>
                        <Slider x:Name="ScaleSlider" Minimum="0.60" Maximum="1.60" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="ScaleSlider_ValueChanged" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="75%" Padding="8,2" Margin="0,0,6,0" Click="ScalePreset_Click" Tag="0.75" />
                            <Button Content="100%" Padding="8,2" Margin="0,0,6,0" Click="ScalePreset_Click" Tag="1.0" />
                            <Button Content="125%" Padding="8,2" Margin="0,0,6,0" Click="ScalePreset_Click" Tag="1.25" />
                            <Button Content="150%" Padding="8,2" Click="ScalePreset_Click" Tag="1.50" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Section 1: Window Switch & Perch Preference -->
                <GroupBox Header="🕵️ 换窗潜行节奏" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="切窗等待时长" DockPanel.Dock="Left" />
                            <TextBlock x:Name="SwitchDelayText" Text="15 秒" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#555" />
                        </DockPanel>
                        <Slider x:Name="SwitchDelaySlider" Minimum="0" Maximum="15" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SwitchDelaySlider_ValueChanged" />
                        <TextBlock Text="当宠物在窗口上方（或开启跟随窗口右侧）时，切到新窗口停留超过该时间才会悄悄切换。" TextWrapping="Wrap" FontSize="11" Foreground="#666" Margin="0,4,0,8" />

                        <DockPanel>
                            <TextBlock Text="陪伴位置偏好" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ComboBox x:Name="PerchPreferenceCombo" SelectionChanged="PerchPreferenceCombo_SelectionChanged" />
                        </DockPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Section 2: Right -> Top Initial Peek & Periodic Independent Top-Bar Effects -->
                <GroupBox Header="🎬 右侧→顶栏陪伴与独立特效" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <CheckBox x:Name="ClimbEnabledCheck" Content="从右侧自动爬上窗口顶栏（左看右看后趴窗朝前）" Margin="0,0,0,8" Checked="ClimbEnabledCheck_Changed" Unchecked="ClimbEnabledCheck_Changed" />

                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="右侧→顶栏等待时长" DockPanel.Dock="Left" />
                            <TextBlock x:Name="ClimbIntervalText" Text="5 分钟" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#555" />
                        </DockPanel>
                        <Slider x:Name="ClimbIntervalSlider" Minimum="3" Maximum="3600" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ClimbIntervalSlider_ValueChanged" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
                            <Button Content="3 秒" Padding="6,2" Margin="0,0,5,0" Click="ClimbPreset_Click" Tag="3" />
                            <Button Content="30 秒" Padding="6,2" Margin="0,0,5,0" Click="ClimbPreset_Click" Tag="30" />
                            <Button Content="1 分钟" Padding="6,2" Margin="0,0,5,0" Click="ClimbPreset_Click" Tag="60" />
                            <Button Content="5 分钟" Padding="6,2" Click="ClimbPreset_Click" Tag="300" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="10 分钟" Padding="6,2" Margin="0,0,5,0" Click="ClimbPreset_Click" Tag="600" />
                            <Button Content="15 分钟" Padding="6,2" Margin="0,0,5,0" Click="ClimbPreset_Click" Tag="900" />
                            <Button Content="30 分钟" Padding="6,2" Margin="0,0,5,0" Click="ClimbPreset_Click" Tag="1800" />
                            <Button Content="45 分钟" Padding="6,2" Margin="0,0,5,0" Click="ClimbPreset_Click" Tag="2700" />
                            <Button Content="1 小时" Padding="6,2" Click="ClimbPreset_Click" Tag="3600" />
                        </StackPanel>

                        <Separator Margin="0,0,0,8" />

                        <CheckBox x:Name="TopEffectsEnabledCheck" Content="在顶栏定时触发独立特效" Margin="0,0,0,8" Checked="TopEffectsEnabledCheck_Changed" Unchecked="TopEffectsEnabledCheck_Changed" />

                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="顶栏特效触发间隔" DockPanel.Dock="Left" />
                            <TextBlock x:Name="EffectIntervalText" Text="15 分钟" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#555" />
                        </DockPanel>
                        <Slider x:Name="EffectIntervalSlider" Minimum="5" Maximum="3600" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="EffectIntervalSlider_ValueChanged" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,8">
                            <Button Content="15 秒" Padding="6,2" Margin="0,0,5,0" Click="EffectPreset_Click" Tag="15" />
                            <Button Content="45 秒" Padding="6,2" Margin="0,0,5,0" Click="EffectPreset_Click" Tag="45" />
                            <Button Content="5 分钟" Padding="6,2" Margin="0,0,5,0" Click="EffectPreset_Click" Tag="300" />
                            <Button Content="15 分钟" Padding="6,2" Margin="0,0,5,0" Click="EffectPreset_Click" Tag="900" />
                            <Button Content="30 分钟" Padding="6,2" Margin="0,0,5,0" Click="EffectPreset_Click" Tag="1800" />
                            <Button Content="1 小时" Padding="6,2" Click="EffectPreset_Click" Tag="3600" />
                        </StackPanel>

                        <TextBlock Text="自动触发包含的独立特效（右键一级菜单也可直接点播）" FontSize="11" Foreground="#666" Margin="0,0,0,6" />
                        <DockPanel Margin="0,0,0,4">
                            <Button Content="播放" DockPanel.Dock="Right" Padding="8,1" Click="PlayEffect_Click" Tag="Patrol" />
                            <CheckBox x:Name="EffectPatrolCheck" Content="🐾 跳走巡逻" VerticalAlignment="Center" Checked="TopEffect_Changed" Unchecked="TopEffect_Changed" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,4">
                            <Button Content="播放" DockPanel.Dock="Right" Padding="8,1" Click="PlayEffect_Click" Tag="FlashStep" />
                            <CheckBox x:Name="EffectFlashCheck" Content="⚡ 闪身步" VerticalAlignment="Center" Checked="TopEffect_Changed" Unchecked="TopEffect_Changed" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,4">
                            <Button Content="播放" DockPanel.Dock="Right" Padding="8,1" Click="PlayEffect_Click" Tag="BearShake" />
                            <CheckBox x:Name="EffectBearCheck" Content="🐻 狗熊哆嗦毛" VerticalAlignment="Center" Checked="TopEffect_Changed" Unchecked="TopEffect_Changed" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,4">
                            <Button Content="播放" DockPanel.Dock="Right" Padding="8,1" Click="PlayEffect_Click" Tag="WandererKick" />
                            <CheckBox x:Name="EffectKickCheck" Content="⚽ 浪子踢球" VerticalAlignment="Center" Checked="TopEffect_Changed" Unchecked="TopEffect_Changed" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,4">
                            <Button Content="播放" DockPanel.Dock="Right" Padding="8,1" Click="PlayEffect_Click" Tag="HeadTilt" />
                            <CheckBox x:Name="EffectHeadTiltCheck" Content="🥺 歪头杀" VerticalAlignment="Center" Checked="TopEffect_Changed" Unchecked="TopEffect_Changed" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,4">
                            <Button Content="播放" DockPanel.Dock="Right" Padding="8,1" Click="PlayEffect_Click" Tag="WindowRoll" />
                            <CheckBox x:Name="EffectRollCheck" Content="🌀 翻肚皮打滚" VerticalAlignment="Center" Checked="TopEffect_Changed" Unchecked="TopEffect_Changed" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,6">
                            <Button Content="播放" DockPanel.Dock="Right" Padding="8,1" Click="PlayEffect_Click" Tag="YawnSleep" />
                            <CheckBox x:Name="EffectSleepCheck" Content="😴 打哈欠睡觉" VerticalAlignment="Center" Checked="TopEffect_Changed" Unchecked="TopEffect_Changed" />
                        </DockPanel>

                        <TextBlock Text="爬上顶栏后默认左看右看并保持朝前趴窗姿态；之后按设定间隔随机播放上方勾选的独立特效。" TextWrapping="Wrap" FontSize="11" Foreground="#666" />
                    </StackPanel>
                </GroupBox>

                <!-- Section 3: Top-Bar Tap Pose Cycle -->
                <GroupBox Header="👆 窗顶单击切换姿态" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <UniformGrid Columns="2" Margin="0,0,0,6">
                            <CheckBox x:Name="TapSitCheck" Content="😊 微笑歪头坐" Margin="0,0,0,6" Checked="TopTapPose_Changed" Unchecked="TopTapPose_Changed" />
                            <CheckBox x:Name="TapLoafCheck" Content="🐾 安静趴卧" Margin="0,0,0,6" Checked="TopTapPose_Changed" Unchecked="TopTapPose_Changed" />
                            <CheckBox x:Name="TapBigHeadCheck" Content="🐶 大头趴窗盯镜头" Checked="TopTapPose_Changed" Unchecked="TopTapPose_Changed" />
                            <CheckBox x:Name="TapSleepCheck" Content="💤 团成团子睡觉" Checked="TopTapPose_Changed" Unchecked="TopTapPose_Changed" />
                        </UniformGrid>
                        <TextBlock Text="在窗口顶栏轻点宠物时，会在已勾选的姿态之间循环切换（至少保留 1 项）。" TextWrapping="Wrap" FontSize="11" Foreground="#666" />
                    </StackPanel>
                </GroupBox>

                <!-- Section 4: Zero-Intrusion Details -->
                <GroupBox Header="✨ 零打扰微交互细节" Padding="10" Margin="0,0,0,6">
                    <StackPanel>
                        <CheckBox x:Name="ShyRetreatCheck" Content="防误点害羞缩头（鼠标高速划过微缩，慢靠近才探头）" Margin="0,0,0,6" Checked="MicroToggle_Changed" Unchecked="MicroToggle_Changed" />
                        <CheckBox x:Name="TypingPauseCheck" Content="打字免打扰（持续输入时暂缓爬顶，停手后再打招呼）" Margin="0,0,0,6" Checked="MicroToggle_Changed" Unchecked="MicroToggle_Changed" />
                        <CheckBox x:Name="ClimbPawsCheck" Content="顶栏先搭爪探头（先露耳尖小爪张望 3 秒，再翻身上顶）" Checked="MicroToggle_Changed" Unchecked="MicroToggle_Changed" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Action Bar -->
        <DockPanel Grid.Row="1" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="恢复默认" Padding="10,4" Margin="0,0,6,0" Click="Reset_Click" />
                <Button Content="👀 预览趴窗" Padding="10,4" Margin="0,0,6,0" Click="PreviewPeek_Click" />
                <Button Content="⚡ 闪身步" Padding="10,4" Click="PlayEffect_Click" Tag="FlashStep" />
            </StackPanel>
            <Button Content="完成" Padding="16,4" IsDefault="True" HorizontalAlignment="Right" Click="Close_Click" />
        </DockPanel>
    </Grid>
</Window>
