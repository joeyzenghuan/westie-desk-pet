<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <AssemblyName>WestieDeskPet</AssemblyName>
    <RootNamespace>WestieDeskPet.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.5.0</Version>
    <Product>Westie Desk Pet</Product>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WestieDeskPet.Core\WestieDeskPet.Core.csproj" />
  </ItemGroup>

  <!-- Single source of truth: link directly to the 82 macOS/shared pixel-art PNG sprites (ZERO duplicated assets in git!) -->
  <ItemGroup>
    <Content Include="..\..\Sources\WestieDeskPet\Resources\Sprites\*.png">
      <Link>Sprites\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\Sources\WestieDeskPet\Resources\AppIcon.png" Condition="Exists('..\..\Sources\WestieDeskPet\Resources\AppIcon.png')">
      <Link>AppIcon.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
